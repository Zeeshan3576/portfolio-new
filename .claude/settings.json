{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npm test *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout prod *)",
      "Bash(git checkout develop *)",
      "Bash(npx prisma migrate *)",
      "Bash(pnpm prisma migrate *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(pnpm prisma migrate reset *)",
      "Bash(npx prisma db push --force-reset *)"
    ]
  }
}
